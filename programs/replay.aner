// Experimental Aner 0.0.8-dev.2. Run from the repository root.
// The only executable application language in this repository is Aner.
import aner.llm

fn ensure(condition: Bool, message: String) -> Unit {
    if !condition {
        let failure: Result<Int64, String> = Result.err(message)
        let unreachable = failure.unwrap()
    }
}

// This reads one known flat digest field in the native receipt format.
// It is deliberately not a general JSON parser.
fn receipt_digest(receipt: String, key: String) -> String {
    let marker = "\"" + key + "\":\""
    let start = receipt.find(marker)
    ensure(start >= 0, "Receipt is missing " + key)
    let remaining = receipt.slice(start + marker.len(), receipt.len())
    let end = remaining.find("\"")
    ensure(end == 64, "Receipt digest length differs")
    let digest = remaining.slice(0, end)
    var i = 0
    while i < digest.len() {
        ensure("0123456789abcdef".contains(digest.get(i)), "Receipt digest is not lowercase SHA256")
        i = i + 1
    }
    return digest
}

print(llm.fetch_artifact(
    url: "https://huggingface.co/Qwen/Qwen3.5-0.8B/resolve/2fc06364715b967f1860aea9cf38778875588b17/model.safetensors-00001-of-00001.safetensors",
    path: "assets/qwen3.5-0.8b-base.safetensors",
    sha256: "04b1c301231dd422b8860db31311ab2721511346a32cb1e079c4c4e5f1fe4696",
    bytes: 1746942600))
print(llm.fetch_artifact(
    url: "https://huggingface.co/ggml-org/Qwen3.5-0.8B-GGUF/resolve/807dfd9a6fadbf703207aac3bfb0b2b3040d077c/Qwen3.5-0.8B-BF16.gguf",
    path: "assets/qwen3.5-0.8b-base-bf16.gguf",
    sha256: "9a7bed4041b7975e0f71fa34670d1e9025213bc92905ac0db75d36c4fa3fa623",
    bytes: 1557662496))
print(llm.fetch_artifact(
    url: "https://raw.githubusercontent.com/RikiyaT/lm_understand-logs/4d09ba6d6a7e891dd8063974dfe81b3d78e3494f/exp8_math/runs/p50c/edit/edit.npz",
    path: "assets/edit.npz",
    sha256: "e92a92aafd1f1068b4fd94aa0fbe081ba3ddea2047ee7bcac7161d861be299e7",
    bytes: 387619))

print(llm.weight_import_npz(
    base: "assets/qwen3.5-0.8b-base.safetensors", archive: "assets/edit.npz",
    specification: "specifications/p50c-safetensors.json", out_path: "generated/p50c-safetensors.json"))
print(llm.weight_check(
    base: "assets/qwen3.5-0.8b-base.safetensors", patch: "generated/p50c-safetensors.json"))
let safetensors = llm.weight_apply(
    base: "assets/qwen3.5-0.8b-base.safetensors", patch: "generated/p50c-safetensors.json",
    out_dir: "generated/qwen-safetensors")
ensure(receipt_digest(safetensors, "candidate_sha256") ==
    "bd5c223dc7d0ed48a6857f798a94da6ec46c40b9ff4e7bc31872dba10f943ae5",
    "Safetensors candidate differs from the verified reference")
print(safetensors)

// GGUF stores the same two BF16 matrices under different names.
// The importer retains the same flat indices and exact stored bits.
print(llm.weight_import_npz(
    base: "assets/qwen3.5-0.8b-base-bf16.gguf", archive: "assets/edit.npz",
    specification: "specifications/p50c-gguf.json", out_path: "generated/p50c-gguf.json"))
print(llm.weight_check(
    base: "assets/qwen3.5-0.8b-base-bf16.gguf", patch: "generated/p50c-gguf.json"))
let gguf = llm.weight_apply(
    base: "assets/qwen3.5-0.8b-base-bf16.gguf", patch: "generated/p50c-gguf.json",
    out_dir: "generated/qwen-gguf")
ensure(receipt_digest(gguf, "candidate_sha256") ==
    "f67c865e3961f13e03ac002de1b797d6806e3f80f5443926ab07a8cf1e023597",
    "GGUF candidate differs from the verified reference")
print(gguf)

